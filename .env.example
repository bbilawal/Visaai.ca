# ─────────────────────────────────────────────────────────────
#  VisaAI — Environment Variables Template
#  Copy this file to .env and fill in the values.
#  Never commit a .env file with real credentials.
# ─────────────────────────────────────────────────────────────

# ── Web (apps/web) ────────────────────────────────────────────
# Public Supabase credentials (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
# Absolute base URL of the web app. Used to build OAuth + password-reset
# redirect targets (e.g. ${SITE}/callback). Must match a redirect URL allowed
# in the Supabase dashboard. Defaults to http://localhost:3000 in dev.
# Production (canonical domain): https://visaai.co
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Build mode: `global` for visaai.co, or `canada` for visaai.ca.
NEXT_PUBLIC_SITE_MODE=global

# URL of the NestJS API
NEXT_PUBLIC_API_URL=http://localhost:4000

# Portal Assistant Chrome extension — used for one-click detection + token handoff
# from the submission page. In production, this is the stable Chrome Web Store ID.
# For local dev, load the extension unpacked (chrome://extensions → "Load unpacked"
# pointing at apps/extension/dist), copy the generated ID, and paste it here.
# http://localhost:3000/* is already in the extension's externally_connectable matches.
NEXT_PUBLIC_EXTENSION_ID=
# Optional override — defaults to chrome.google.com/webstore/detail/<extension-id>
NEXT_PUBLIC_CHROME_WEB_STORE_URL=

# Stripe publishable key (safe to expose to the browser)
STRIPE_PUBLISHABLE_KEY=pk_test_...

# ── API (apps/api) ────────────────────────────────────────────
# Supabase service-role key (KEEP SECRET — server only)

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SUPABASE_ANON_KEY=<anon-key>
SUPABASE_JWT_SECRET=<jwt-secret>

# OpenAI (used by all LangGraph agents)
OPENAI_API_KEY=sk-...

# Runtime. In production the API refuses to boot unless DATA_RESIDENCY_MODE is
# not "global" AND OCR_PROVIDER is a regional managed provider.
NODE_ENV=development

# Data residency (global platform): region-aware document processing.
#   regional | global | jurisdiction-specific
DATA_RESIDENCY_MODE=global
OCR_REGION=global              # e.g. ca-central-1 | eu | us-east | ap-southeast-1

# OCR provider (vendor-agnostic). mock/openai are non-regional (dev only);
# azure-di / aws-textract / google-docai are regional managed services.
OCR_PROVIDER=mock              # mock | openai | azure-di | aws-textract | google-docai

# derive_fields: a SECOND extraction pass over the OCR text, used to read the
# fields a provider's own document model does not return (an admission letter's
# tuition, a deed's title number, a bank statement's period). It runs on OpenAI,
# which is NON-REGIONAL — it sends document text to the US.
#   auto (default) — on under DATA_RESIDENCY_MODE=global, OFF otherwise
#   on             — explicit opt-in; you are accepting that egress
#   off            — never run
# Setting this to "on" under regional/jurisdiction-specific residency walks
# around the same guard that blocks a non-regional OCR_PROVIDER. Make that
# decision deliberately, or extract these fields with a regional provider model.
OCR_DERIVE_FIELDS=auto         # auto | on | off

# Regional OCR provider credentials (set the ones for your chosen OCR_PROVIDER)
# AZURE_DOC_INTEL_ENDPOINT=https://<resource>.cognitiveservices.azure.com/
# AZURE_DOC_INTEL_KEY=<key>
# Analysis model. LEAVE UNSET (recommended): the adapter then routes per
# document type — prebuilt-idDocument for passports/IDs, and prebuilt-layout
# with the queryFields add-on for everything else, because idDocument returns
# NO fields for a bank statement, admission letter, birth certificate or deed.
# Query fields are a PREMIUM Azure add-on billed per request (max 20 fields),
# and they run in your Azure region, so this keeps document data in-region.
# Setting this pins ONE model for every upload and disables query fields:
# no add-on billing, and no extracted fields for non-identity documents.
# AZURE_DOC_INTEL_MODEL=prebuilt-idDocument
# AWS_OCR_ACCESS_KEY_ID=<key>
# AWS_OCR_SECRET_ACCESS_KEY=<secret>
# GOOGLE_DOCAI_PROCESSOR_ID=<processor-id>
# GOOGLE_DOCAI_CREDENTIALS=<service-account-json>

# Malware scanning is MANDATORY (baseline content gate always runs).
# SCAN_PROVIDER optionally adds an external AV engine on top.
SCAN_PROVIDER=none             # none | clamav | virustotal
MAX_UPLOAD_BYTES=15728640      # 15 MB

# Upstash Redis (BullMQ job queue)
UPSTASH_REDIS_REST_URL=https://<instance>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<token>

# Stripe (KEEP SECRET — server only)
STRIPE_SECRET_KEY=sk_test_...
# Signing secret for the ACCOUNT (platform) webhook endpoint -> POST /billing/webhook
STRIPE_WEBHOOK_SECRET=whsec_...
# Signing secret for the CONNECT webhook endpoint -> POST /billing/webhook/connect.
# Register that endpoint in Stripe with connect:true; it receives connected-account
# events (account.updated). Platform-owned events (transfer.reversed) stay on the
# account endpoint above. Falls back to STRIPE_WEBHOOK_SECRET when unset, which is
# only correct if both Stripe endpoints point at the same URL.
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...
# Stripe Connect (consultant payouts, M4) — onboarding Account Link redirects.
# Optional; defaults to the web consultant payouts page when unset.
STRIPE_CONNECT_REFRESH_URL=
STRIPE_CONNECT_RETURN_URL=

# SP2 subscriptions. Off by default; when true, SUBSCRIPTION_PRICES is REQUIRED
# (enforced in config/configuration.ts) or the API refuses to boot.
SUBSCRIPTIONS_ENABLED=false
# Stripe Price ids for base/pro/premium x month/year. Ids differ per Stripe mode,
# so regenerate this per environment — do not copy test ids into live:
#   scripts/stripe/sync-price-catalog.py --key sk_live_...
SUBSCRIPTION_PRICES={"base":{"month":"price_...","year":"price_..."},"pro":{"month":"price_...","year":"price_..."},"premium":{"month":"price_...","year":"price_..."}}
# Free-trial length applied at subscription checkout. 0 = charge immediately.
SUBSCRIPTION_TRIAL_DAYS=0

# Postmark inbound email webhook
INBOUND_WEBHOOK_SECRET=<random-secret-string>

# AES-256 encryption key for inbound email storage (64 hex chars = 32 bytes)
EMAIL_ENCRYPTION_KEY=<64-char-hex-string>

# Postmark outbound (transactional email — reminders)

# Phase 2 RBAC: comma-separated admin emails. Safe role-resolution fallback so
# admins resolve to appRole='admin' even before app_metadata.role is seeded.
ADMIN_EMAILS=

# URL of the Next.js web app (for CORS)
WEB_URL=http://localhost:3000
SITE_MODE=global
# Optional comma-separated additional browser origins when one API serves both
# sites, for example https://visaai.co,https://visaai.ca.
WEB_URLS=

# Base URL of the deployed NestJS API (used for unsubscribe links in emails)
API_URL=http://localhost:4000

# ── Supabase CLI (local dev) ──────────────────────────────────
# These are set automatically by `supabase start`; listed here for reference.
# SUPABASE_DB_PASSWORD=postgres

# --- Analytics (SP-A) ---
ANALYTICS_WAREHOUSE=supabase          # supabase | mock
ANALYTICS_RAW_RETENTION_DAYS=90       # raw event partitions dropped after N days
ANALYTICS_INGEST_BATCH=100            # events per bulk-insert job
ANALYTICS_COLLECT_MAX_EVENTS=50       # events per /analytics/collect request
ANALYTICS_ROLLUP_LOOKBACK_DAYS=3      # rollup recompute lookback window
NEXT_PUBLIC_ANALYTICS_ENABLED=true    # web client SDK on/off (client-side)

# --- Analytics SP-B (KPI engine) ---
KPI_SOURCE=supabase                   # supabase | mock
KPI_ROLLUP_LOOKBACK_DAYS=3            # days re-scanned each recompute (late events)
KPI_ROLLUP_INTERVAL_MIN=15           # kpi rollup tick cadence
KPI_COHORT_INTERVAL_HOURS=24         # cohort recompute cadence
KPI_ROLLUP_STALE_MIN=15              # meta.stale threshold for rollup metrics
KPI_COHORT_STALE_HOURS=24            # meta.stale threshold for cohort metrics

# --- Analytics SP-C (metrics/reports API) ---
ANALYTICS_CACHE_TTL_SEC=60           # request cache TTL for metric results
ANALYTICS_REPORTS_TICK_MIN=5         # scheduled-report dispatcher cadence
ANALYTICS_ALERTS_TICK_MIN=5          # alert evaluator cadence

# ── Runtime / observability ───────────────────────────────────
# Port the NestJS API listens on.
PORT=4000

# Pino log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Sentry error tracking. UNSET = Sentry is a no-op (captureException does
# nothing). Setting this is launch blocker BLK-3 — leaving it blank means
# production runs with no error tracking and no alerting.
SENTRY_DSN=

# ── Notifications ─────────────────────────────────────────────
# Dead-letter queue depth that triggers an operational alert.
NOTIFICATION_DLQ_ALERT_THRESHOLD=10

# Web push (VAPID). REQUIRED for browser push. When unset the service logs
# "VAPID keys not set — push skipped" and silently delivers nothing — there is
# no boot failure, so an environment provisioned without these looks healthy
# while every web push is dropped. Generate with `npx web-push generate-vapid-keys`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:no-reply@visaai.co

# ── SMTP (alternative mail transport to Postmark) ─────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@visaai.co

# ── Queue ─────────────────────────────────────────────────────
# Direct Redis connection for BullMQ. In production this is the Upstash
# endpoint; UPSTASH_REDIS_REST_* above is the REST transport used elsewhere.
REDIS_URL=redis://localhost:6379
