**/.env
**/.env.local
**/.env.*.local
**/node_modules/
# pnpm content-addressable store, when pnpm puts it inside the repo.
.pnpm-store/
**/dist/
**/dist-selfhost/
# Extension release zips (apps/extension/pack.mjs) — reproducible from source.
apps/extension/release/
**/.next/
**/.expo/
**/coverage/
# Expo managed workflow: native projects are generated by `expo prebuild`/EAS
apps/mobile/ios/
apps/mobile/android/

# Supabase CLI local state (project ref, pooler url, versions)
supabase/.temp/

# graphify build output (knowledge graph) — regenerable, not tracked
graphify-out/

# Playwright admin auth storageState (generated by e2e/auth.setup.ts)
apps/web/e2e/.auth/

# Audit program evidence logs — local artifacts, referenced by path from
# docs/audit/ reports. Not committed (jest/build output, and command lines that
# embed local Supabase demo keys which would trip the secret scanner).
.ai-audit/logs/

# Jest coverage output (apps/api/coverage).
coverage/

# Python bytecode (scripts/stripe/ tooling).
__pycache__/
*.pyc

# macOS Finder metadata. Never useful in history, and it reappears in every
# directory anyone browses — it was sitting untracked in the repo root.
.DS_Store
**/.DS_Store

# deploy-web.sh staging/rollback builds (atomic swap)
.next-staging/
.next-prev/
dist-staging/
dist-prev/
