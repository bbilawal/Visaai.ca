# VisaAI mobile — public runtime configuration.
#
# EVERYTHING HERE SHIPS INSIDE THE APP BINARY and is readable by anyone who
# installs it. Only values that are safe to publish belong in this file.
#
# NEVER put these in a mobile env file:
#   SUPABASE_SERVICE_ROLE_KEY   (bypasses RLS — full database access)
#   STRIPE_SECRET_KEY           (can move money)
#   VAPID_PRIVATE_KEY           (can send push to every subscriber)
#   SUPABASE_JWT_SECRET         (can mint valid sessions for any user)
# Those are server-only and live in apps/api/.env on the VPS.
#
# Copy to `.env` for local development. CI supplies its own placeholders; EAS
# builds read APP_ENV from the build profile in eas.json.

# Which variant to build/run: development | test | staging | production
APP_ENV=development

# Overrides the per-environment defaults in src/config/env.ts.
# iOS simulator can reach the host on localhost; an Android emulator needs
# http://10.0.2.2:4000 instead.
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_WEB_URL=http://localhost:3000

# Supabase project (the SAME project as apps/web — mobile is another client of it).
# The anon key is designed to be public; RLS is the security boundary.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Optional
# Crash reporting. Unset -> the SDK is never initialised (no events leave the
# device). PII, screenshots and tracing are disabled in code regardless.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_ANALYTICS_ENABLED=true
EXPO_PUBLIC_REQUEST_TIMEOUT_MS=20000

# Set by EAS; only needed locally if you run `eas build` from this machine.
# EAS_PROJECT_ID=
