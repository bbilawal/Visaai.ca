{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm --filter web start -p 3101",
      "url": [
        "http://localhost:3101/en",
        "http://localhost:3101/en/login",
        "http://localhost:3101/en/signup",
        "http://localhost:3101/en/pricing",
        "http://localhost:3101/en/privacy"
      ],
      "numberOfRuns": 3,
      "settings": { "preset": "desktop" }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:seo": ["error", { "minScore": 0.95 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": "./.lighthouseci" }
  }
}
