{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "modules/prefill/fonts/*.ttf"
      },
      {
        "include": "modules/prefill/fonts/*.otf"
      }
    ]
  }
}
