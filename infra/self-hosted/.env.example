# ── Self-hosted Supabase ─────────────────────────────────────────────────
# Copy to .env and fill EVERY value. Never commit .env.
#
# Generate the JWT secret and the two keys together — the keys are JWTs SIGNED
# with the secret, so a mismatched set fails in confusing ways (PostgREST 401s
# while GoTrue looks fine). See runbook.md §2 for the one-liner that emits all
# three consistently.

POSTGRES_PASSWORD=            # strong; also used by GoTrue/PostgREST/Storage roles
POSTGRES_DB=postgres
POSTGRES_PORT=54422

JWT_SECRET=                   # >= 32 chars
JWT_EXPIRY=3600
ANON_KEY=                     # JWT signed with JWT_SECRET, role=anon
SERVICE_ROLE_KEY=             # JWT signed with JWT_SECRET, role=service_role

KONG_HTTP_PORT=54421
API_EXTERNAL_URL=http://localhost:54421
SITE_URL=http://localhost:3000
ADDITIONAL_REDIRECT_URLS=

# AUTH-001 — 12, not the platform default of 8.
PASSWORD_MIN_LENGTH=12
MAILER_AUTOCONFIRM=false
# Comma-separated hosts GoTrue accepts from Host/X-Forwarded-Host when building
# links (e.g. visaai.co). Leave empty and it warns on every request instead.
MAILER_EXTERNAL_HOSTS=

# DB-004 — bucket-level ceiling matching the app's 25MB MAX_BYTES, so an upload
# that bypasses the API is still bounded.
STORAGE_FILE_SIZE_LIMIT=26214400

# PostgREST row ceiling — backstop for unbounded list queries.
PGRST_DB_MAX_ROWS=1000

# SMTP (the app sends via nodemailer; GoTrue needs its own for auth emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=no-reply@visaai.co

# OAuth — both are ENABLED on the hosted project; set these to keep parity.
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=
AZURE_ENABLED=false
AZURE_CLIENT_ID=
AZURE_SECRET=

# ── Backups (BLK-1) ────────────────────────────────────────────────
# The stack dumps itself on this interval and prunes older files. Backups live
# on the 'backups' named volume; ship them OFF-HOST before this holds real
# data — a dump on the same machine as the database is not disaster recovery.
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400
# If the first backup after a (re)start fails, retry this often, this many
# times, before waiting a full interval (the db may still be starting).
BACKUP_INITIAL_RETRY_SECONDS=60
BACKUP_INITIAL_RETRIES=30
