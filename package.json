{
  "packageManager": "pnpm@9.15.9",
  "name": "visaai",
  "private": true,
  "scripts": {
    "build:types": "pnpm --filter @visaai/types build",
    "predev": "pnpm build:types",
    "dev": "concurrently \"pnpm --filter @visaai/types watch\" \"pnpm --filter web dev\" \"pnpm --filter api start:dev\"",
    "build": "pnpm build:types && pnpm --filter web build && pnpm --filter api build",
    "i18n:review": "node scripts/i18n/build-review-package.mjs",
    "supabase": "npx --yes supabase@latest"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20 <21",
    "pnpm": ">=9"
  },
  "pnpm": {
    "overrides": {
      "axios@>=1.0.0 <1.18.0": "^1.19.0",
      "brace-expansion@1": "^1.1.18",
      "brace-expansion@2": "^2.1.4",
      "brace-expansion@>=4": "^5.0.9",
      "fast-uri@3": "^3.1.5",
      "form-data@4": "^4.0.6",
      "js-yaml@3": "^3.15.0",
      "js-yaml@4": "^4.3.0",
      "multer@>=1.0.0 <2.2.0": "^2.2.0",
      "postcss@8": "^8.5.26",
      "sharp": "^0.35.3",
      "shell-quote": "^1.8.5",
      "socket.io-parser@4": "^4.2.7",
      "tmp": "^0.2.6",
      "uuid@11": "^11.1.1",
      "ws@8": "^8.21.2"
    }
  }
}
